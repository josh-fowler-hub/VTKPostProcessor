import vtk
import numpy as np
import pandas as pd
import os
import matplotlib.pyplot as plt
from scipy.interpolate import griddata

class CFDPostProcessor:
class CFDPostProcessor:
    def __init__(self, file_path):
        """Load VTK file using pure VTK library"""
        self.file_path = file_path
        self.reader = None
        self.dataset = None
        self.data = []
        
        # Try to load the file based on extension
        if file_path.endswith('.vtm'):
            self.reader = vtk.vtkXMLMultiBlockDataReader()
        elif file_path.endswith('.vtu'):
            self.reader = vtk.vtkXMLUnstructuredGridReader()
        elif file_path.endswith('.vtp'):
            self.reader = vtk.vtkXMLPolyDataReader()
        elif file_path.endswith('.vtk'):
            self.reader = vtk.vtkUnstructuredGridReader()
        else:
            raise ValueError(f"Unsupported file format: {file_path}")
        
        self.reader.SetFileName(file_path)
        self.reader.Update()
        self.dataset = self.reader.GetOutput()
        
        # Handle multiblock vs single block
        if hasattr(self.dataset, 'GetNumberOfBlocks'):
            # Multiblock dataset
            self.data = []
            for i in range(self.dataset.GetNumberOfBlocks()):
                block = self.dataset.GetBlock(i)
                if block is not None:
                    self.data.append(block)
            print(f"Loaded multiblock dataset with {len(self.data)} blocks")
            
            # Combine all blocks for mesh property
            if self.data:
                self.mesh = self.data[0]  # Use first block as primary mesh
            else:
                self.mesh = None
        else:
            # Single dataset
            self.data = [self.dataset]
            self.mesh = self.dataset
            print("Loaded single block dataset")
    
    def get_block_names(self, verbose=True):
        """Get names of all blocks in the dataset"""
        block_names = []
        for i, block in enumerate(self.data):
            if block is not None:
                block_names.append(f"Block_{i}")
        
        if verbose:
            print(f"Available blocks: {block_names}")
        return block_names
    
    def get_variable_names(self, block_index=0, verbose=True):
        """Get variable names from specified block"""
        if block_index >= len(self.data):
            raise ValueError(f"Block index {block_index} out of range")
        
        block = self.data[block_index]
        
        # Cell data fields
        cell_data = block.GetCellData()
        cell_fields = [cell_data.GetArrayName(i) for i in range(cell_data.GetNumberOfArrays())]
        
        # Point data fields
        point_data = block.GetPointData()
        point_fields = [point_data.GetArrayName(i) for i in range(point_data.GetNumberOfArrays())]
        
        if verbose:
            print(f"Block {block_index} fields:")
            print(f"  Cell data: {cell_fields}")
            print(f"  Point data: {point_fields}")
        
        return {"point_data": point_fields, "cell_data": cell_fields}
    
    def extract_field_data(self, block_id=0, field_name='p', data_type='cell'):
        """Extract coordinates and field data from VTK dataset"""
        if block_id >= len(self.data):
            raise ValueError(f"Block {block_id} out of range")
        
        block = self.data[block_id]
        
        # Get coordinates and field data
        if data_type == 'cell':
            data_arrays = block.GetCellData()
            n_elements = block.GetNumberOfCells()
            
            # Get cell centers for coordinates
            centers = vtk.vtkCellCenters()
            centers.SetInputData(block)
            centers.Update()
            center_points = centers.GetOutput().GetPoints()
            coords = np.zeros((n_elements, 3))
            for i in range(n_elements):
                coords[i] = center_points.GetPoint(i)
        else:
            data_arrays = block.GetPointData()
            n_elements = block.GetNumberOfPoints()
            points = block.GetPoints()
            coords = np.zeros((n_elements, 3))
            for i in range(n_elements):
                coords[i] = points.GetPoint(i)
        
        # Find the field
        field_array = data_arrays.GetArray(field_name)
        if field_array is None:
            available_fields = [data_arrays.GetArrayName(i) for i in range(data_arrays.GetNumberOfArrays())]
            raise ValueError(f"Field '{field_name}' not found. Available: {available_fields}")
        
        # Extract field values
        field_values = np.zeros(n_elements)
        for i in range(n_elements):
            field_values[i] = field_array.GetValue(i)
        
        return coords, field_values

    def plot_contour_matplotlib(self, field_name='p', block_id=0, data_type='cell', n_contours=15, save_path=None):
        """Create 2D contour plot using matplotlib"""
        print(f"Creating matplotlib contour for field '{field_name}'...")
        
        # Extract data
        coords, field_values = self.extract_field_data(block_id, field_name, data_type)
        
        # Project to 2D (X-Y plane)
        x = coords[:, 0]
        y = coords[:, 1]
        
        print(f"Data points: {len(x)}")
        print(f"X range: {x.min():.3f} to {x.max():.3f}")
        print(f"Y range: {y.min():.3f} to {y.max():.3f}")
        print(f"{field_name} range: {field_values.min():.3f} to {field_values.max():.3f}")
        
        # Create regular grid
        resolution = 150
        xi = np.linspace(x.min(), x.max(), resolution)
        yi = np.linspace(y.min(), y.max(), resolution)
        Xi, Yi = np.meshgrid(xi, yi)
        
        # Interpolate to grid
        Zi = griddata((x, y), field_values, (Xi, Yi), method='linear')
        
        # Create plot
        fig, ax = plt.subplots(figsize=(12, 8))
        
        # Filled contours
        contourf = ax.contourf(Xi, Yi, Zi, levels=n_contours, cmap='viridis', alpha=0.8)
        
        # Contour lines
        contour = ax.contour(Xi, Yi, Zi, levels=n_contours, colors='black', alpha=0.4, linewidths=0.5)
        
        # Add colorbar
        cbar = plt.colorbar(contourf, ax=ax)
        cbar.set_label(field_name)
        
        # Labels and title
        ax.set_xlabel('X')
        ax.set_ylabel('Y')
        ax.set_title(f'Contour Plot: {field_name} (Block {block_id}, {data_type} data)')
        ax.set_aspect('equal')
        
        # Save
        if save_path is None:
            save_path = f'contour_{field_name}_block_{block_id}.png'
        plt.savefig(save_path, dpi=300, bbox_inches='tight')
        plt.close()
        
        print(f"✓ Contour plot saved: {save_path}")
        return save_path
    def __init__(self, file_paths, labels=None):
        """
        file_paths: list of dataset file paths
        labels: optional list of labels for each dataset
        """
        self.processors = [CFDPostProcessor(fp) for fp in file_paths]
        self.labels = labels if labels is not None else [f'Dataset {i}' for i in range(len(file_paths))]

    def compare_bar(self, field, agg_func='mean', save_path=None):
        import matplotlib.pyplot as plt
        """
        Bar chart comparing aggregated field values across datasets.
        """
        import matplotlib.pyplot as plt
        values = []
        for proc in self.processors:
            mesh = proc.mesh
            if field in mesh.point_data:
                data = mesh.point_data[field]
                if agg_func == 'mean':
                    val = np.mean(data)
                elif agg_func == 'sum':
                    val = np.sum(data)
                else:
                    val = np.mean(data)
                values.append(val)
            else:
                values.append(np.nan)
        import matplotlib.pyplot as plt
        plt.figure()
        plt.bar(self.labels, values)
        plt.ylabel(field)
        plt.title(f'Comparison Bar Chart: {field} ({agg_func})')
        fname = save_path or f'compare_bar_{field}_{agg_func}.png'
        plt.savefig(fname)
        plt.close()

    def compare_line(self, field, x_axis, combine_func='mean', save_path=None):
        import matplotlib.pyplot as plt
        """
        Overlay line plots for field vs x_axis across datasets.
        """
        import matplotlib.pyplot as plt
        plt.figure()
        for proc, label in zip(self.processors, self.labels):
            mesh = proc.mesh
            if field in mesh.point_data and x_axis in mesh.point_data:
                x = mesh.point_data[x_axis]
                y = mesh.point_data[field]
                # Optionally bin and aggregate
                df = pd.DataFrame({x_axis: x, field: y})
                grouped = df.groupby(x_axis)[field]
                if combine_func == 'mean':
                    y_combined = grouped.mean()
                elif combine_func == 'sum':
                    y_combined = grouped.sum()
                else:
                    y_combined = grouped.mean()
                plt.plot(y_combined.index, y_combined.values, label=label)
        plt.xlabel(x_axis)
        plt.ylabel(field)
        plt.title(f'Comparison Line Plot: {field} vs {x_axis}')
        plt.legend()
        fname = save_path or f'compare_line_{field}_vs_{x_axis}.png'
        plt.savefig(fname)
        plt.close()

    def compare_scatter(self, field_x, field_y, save_path=None):
        import matplotlib.pyplot as plt
        """
        Overlay scatter plots for field_y vs field_x across datasets.
        """
        import matplotlib.pyplot as plt
        plt.figure()
        for proc, label in zip(self.processors, self.labels):
            mesh = proc.mesh
            if field_x in mesh.point_data and field_y in mesh.point_data:
                plt.scatter(mesh.point_data[field_x], mesh.point_data[field_y], label=label, alpha=0.6)
        plt.xlabel(field_x)
        plt.ylabel(field_y)
        plt.title(f'Comparison Scatter Plot: {field_y} vs {field_x}')
        plt.legend()
        fname = save_path or f'compare_scatter_{field_y}_vs_{field_x}.png'
        plt.savefig(fname)
        plt.close()

    def get_processor(self, idx):
        """
        Access individual CFDPostProcessor by index.
        """
        return self.processors[idx]

import pyvista as pv
import numpy as np
import pandas as pd

class CFDPostProcessor:
    def __init__(self, file_path):
        self.file_path = file_path
        if PYVISTA_AVAILABLE:
            self.dataset = pv.read(file_path)
            if isinstance(self.dataset, pv.MultiBlock):
                self.mesh = self.dataset.combine()
                self.data = self.dataset  # Keep multiblock for individual access
            else:
                self.mesh = self.dataset
                self.data = [self.dataset]  # Wrap single mesh in list for consistency
        else:
            # When PyVista is not available, we'll load data differently
            print("PyVista not available - limited functionality mode")
            # For now, we'll use a placeholder that will work with alternative backends
            self.dataset = None
            self.mesh = None
            self.data = None

    def slice_and_average(self, axis='y', num_slices=100, data_type='cell'):
        bounds = self.mesh.bounds
        axis_index = {'x': 0, 'y': 2, 'z': 4}[axis]
        min_val = bounds[axis_index]
        max_val = bounds[axis_index + 1]
        y_range = max_val - min_val
        slice_thickness = y_range / num_slices
        results = []
        for i in range(num_slices):
            lower = min_val + i * slice_thickness
            upper = lower + slice_thickness
            mid = (lower + upper) / 2
            box_bounds = list(bounds)
            box_bounds[axis_index] = lower
            box_bounds[axis_index + 1] = upper
            sliced = self.mesh.clip_box(bounds=tuple(box_bounds), invert=False)
            
            # Choose data source based on data_type
            data_source = sliced.cell_data if data_type == 'cell' else sliced.point_data
            num_elements = sliced.n_cells if data_type == 'cell' else sliced.n_points
            
            if num_elements > 0 and data_source:
                averages = {}
                for name in data_source:
                    data_array = data_source[name]
                    if data_array.size > 0:
                        averages[name] = np.mean(data_array)
                averages[f'{axis}_min'] = lower
                averages[f'{axis}_max'] = upper
                averages[f'{axis}_mid'] = mid
                averages[f'{axis}_min_norm'] = (lower - min_val) / y_range
                averages[f'{axis}_max_norm'] = (upper - min_val) / y_range
                averages[f'{axis}_mid_norm'] = (mid - min_val) / y_range
                results.append(averages)
        df = pd.DataFrame(results)
        return df

    def _get_data_array(self, mesh, field, data_type='cell'):
        """Helper method to get data array from either cell or point data"""
        if data_type == 'cell':
            return mesh.cell_data.get(field) if field in mesh.cell_data else None
        else:
            return mesh.point_data.get(field) if field in mesh.point_data else None

    def get_block_names(self, verbose=True):
        """
        Returns a list of block names and indices if the dataset is a MultiBlock.
        Prints them if verbose=True.
        """
        if isinstance(self.dataset, pv.MultiBlock):
            block_names = []
            for i in range(len(self.dataset)):
                name = self.dataset.get_block_name(i)
                block_names.append((i, name))
                if verbose:
                    print(f"Block {i}: {name}")
            return block_names
        else:
            if verbose:
                print("Dataset is not a MultiBlock.")
            return []

    def get_variable_names(self, block_index=None, verbose=True):
        """
        Returns a list of variable names (point and cell data).
        If block_index is provided, gets variables for that block.
        Otherwise, gets variables for the main mesh.
        Prints them if verbose=True.
        """
        mesh = self.mesh
        if block_index is not None and isinstance(self.dataset, pv.MultiBlock):
            mesh = self.dataset[block_index]
        point_vars = list(mesh.point_data.keys())
        cell_vars = list(mesh.cell_data.keys())
        if verbose:
            print("Point Data Variables:", point_vars)
            print("Cell Data Variables:", cell_vars)
        return {"point_data": point_vars, "cell_data": cell_vars}

    def save_averages(self, df, output_csv):
        df.to_csv(output_csv, index=False)
        print(f"Saved: {output_csv}")

    def plot_contour(self, block_indices=None, field=None, n_contours=10, save_path=None, data_type='cell'):
        """
        Plot contour(s) for the specified field. If block_indices is provided and the dataset is MultiBlock, plot only those blocks.
        """
        if not RENDERING_AVAILABLE:
            print(f"Skipping contour plot for field '{field}' - rendering not available.")
            return
            
        import matplotlib.pyplot as plt

        try:
            if isinstance(self.dataset, pv.MultiBlock) and block_indices is not None:
                blocks = [self.dataset[i] for i in block_indices if self.dataset[i] is not None]
                plotter = pv.Plotter(off_screen=True)
                for block in blocks:
                    data_dict = block.cell_data if data_type == 'cell' else block.point_data
                    if field and field in data_dict:
                        # Convert cell data to point data if needed for contouring
                        if data_type == 'cell':
                            block = block.cell_data_to_point_data()
                        contours = block.contour(isosurfaces=n_contours, scalars=field)
                        plotter.add_mesh(contours, scalars=field, cmap='viridis')
                    else:
                        plotter.add_mesh(block)
                if save_path:
                    plotter.show(screenshot=save_path)
                    print(f"Contour plot saved: {save_path}")
                else:
                    plotter.show()
                plotter.close()
            else:
                mesh = self.mesh
                plotter = pv.Plotter(off_screen=True)
                data_dict = mesh.cell_data if data_type == 'cell' else mesh.point_data
                if field and field in data_dict:
                    # Convert cell data to point data if needed for contouring
                    if data_type == 'cell':
                        mesh = mesh.cell_data_to_point_data()
                    contours = mesh.contour(isosurfaces=n_contours, scalars=field)
                    plotter.add_mesh(contours, scalars=field, cmap='viridis')
                else:
                    plotter.add_mesh(mesh)
                if save_path:
                    plotter.show(screenshot=save_path)
                    print(f"Contour plot saved: {save_path}")
                else:
                    plotter.show()
                plotter.close()
        except Exception as e:
            print(f"Error creating contour plot: {e}")
            print("This is likely due to graphics/rendering limitations in your environment.")

    def plot_line(self, field, x_axis, mode='separate', block_indices=None, combine_func='mean', save_path=None, data_type='cell'):
        """
        Plot line(s) for the specified field vs x_axis.
        mode: 'separate' (one plot per block), 'overlay' (all blocks on one plot), 'combined' (aggregate values)
        block_indices: list of block indices to plot (for MultiBlock)
        combine_func: aggregation function for 'combined' mode ('mean', 'sum')
        """
        import matplotlib.pyplot as plt
        if isinstance(self.dataset, pv.MultiBlock):
            blocks = [self.dataset[i] for i in (block_indices if block_indices is not None else range(len(self.dataset))) if self.dataset[i] is not None]
        else:
            blocks = [self.mesh]

        if mode == 'separate':
            for idx, block in enumerate(blocks):
                data_dict = block.cell_data if data_type == 'cell' else block.point_data
                if field in data_dict and x_axis in data_dict:
                    plt.figure()
                    plt.plot(data_dict[x_axis], data_dict[field], label=f'Block {idx}')
                    plt.xlabel(x_axis)
                    plt.ylabel(field)
                    plt.title(f'Block {idx}: {field} vs {x_axis}')
                    plt.legend()
                    fname = save_path or f'lineplot_block{idx}_{field}_vs_{x_axis}.png'
                    plt.savefig(fname)
                    plt.close()
        elif mode == 'overlay':
            plt.figure()
            for idx, block in enumerate(blocks):
                data_dict = block.cell_data if data_type == 'cell' else block.point_data
                if field in data_dict and x_axis in data_dict:
                    plt.plot(data_dict[x_axis], data_dict[field], label=f'Block {idx}')
            plt.xlabel(x_axis)
            plt.ylabel(field)
            plt.title(f'Overlay: {field} vs {x_axis}')
            plt.legend()
            fname = save_path or f'lineplot_overlay_{field}_vs_{x_axis}.png'
            plt.savefig(fname)
            plt.close()
        elif mode == 'combined':
            # Aggregate values by x_axis
            all_x = []
            all_y = []
            for block in blocks:
                data_dict = block.cell_data if data_type == 'cell' else block.point_data
                if field in data_dict and x_axis in data_dict:
                    all_x.append(data_dict[x_axis])
                    all_y.append(data_dict[field])
            if all_x and all_y:
                x_concat = np.concatenate(all_x)
                y_concat = np.concatenate(all_y)
                # Bin by x_axis
                df = pd.DataFrame({x_axis: x_concat, field: y_concat})
                grouped = df.groupby(x_axis)[field]
                if combine_func == 'mean':
                    y_combined = grouped.mean()
                elif combine_func == 'sum':
                    y_combined = grouped.sum()
                else:
                    y_combined = grouped.mean()
                plt.figure()
                plt.plot(y_combined.index, y_combined.values, label=f'Combined ({combine_func})')
                plt.xlabel(x_axis)
                plt.ylabel(field)
                plt.title(f'Combined: {field} vs {x_axis}')
                plt.legend()
                fname = save_path or f'lineplot_combined_{field}_vs_{x_axis}.png'
                plt.savefig(fname)
                plt.close()

    def plot_bar(self, field, agg_func='mean', block_indices=None, combined=False, save_path=None, data_type='cell'):
        """
        Plot bar chart for the specified field.
        agg_func: aggregation function ('mean', 'sum', etc.)
        block_indices: list of block indices to plot (for MultiBlock)
        combined: if True, aggregate across all blocks
        """
        import matplotlib.pyplot as plt
        values = []
        labels = []
        if isinstance(self.dataset, pv.MultiBlock):
            blocks = [self.dataset[i] for i in (block_indices if block_indices is not None else range(len(self.dataset))) if self.dataset[i] is not None]
        else:
            blocks = [self.mesh]

        if combined:
            all_data = []
            for block in blocks:
                data_dict = block.cell_data if data_type == 'cell' else block.point_data
                if field in data_dict:
                    all_data.append(data_dict[field])
            if all_data:
                concat = np.concatenate(all_data)
                if agg_func == 'mean':
                    val = np.mean(concat)
                elif agg_func == 'sum':
                    val = np.sum(concat)
                else:
                    val = np.mean(concat)
                values.append(val)
                labels.append(f'Combined ({agg_func})')
        else:
            for idx, block in enumerate(blocks):
                data_dict = block.cell_data if data_type == 'cell' else block.point_data
                if field in data_dict:
                    data = data_dict[field]
                    if agg_func == 'mean':
                        val = np.mean(data)
                    elif agg_func == 'sum':
                        val = np.sum(data)
                    else:
                        val = np.mean(data)
                    values.append(val)
                    labels.append(f'Block {idx}')
        plt.figure()
        plt.bar(labels, values)
        plt.ylabel(field)
        plt.title(f'Bar Chart: {field} ({agg_func})')
        fname = save_path or f'barplot_{field}_{agg_func}.png'
        plt.savefig(fname)
        plt.close()

    def plot_block_percentage_bar(self, field, block_indices=None, save_path=None, data_type='cell'):
        """
        Plot bar chart of percentage of total summed value in each block for the given field.
        """
        import matplotlib.pyplot as plt
        values = []
        labels = []
        if isinstance(self.dataset, pv.MultiBlock):
            blocks = [self.dataset[i] for i in (block_indices if block_indices is not None else range(len(self.dataset))) if self.dataset[i] is not None]
        else:
            blocks = [self.mesh]
        for idx, block in enumerate(blocks):
            data_dict = block.cell_data if data_type == 'cell' else block.point_data
            if field in data_dict:
                val = np.sum(data_dict[field])
                values.append(val)
                labels.append(f'Block {idx}')
        total = np.sum(values)
        percentages = [100 * v / total if total > 0 else 0 for v in values]
        plt.figure()
        plt.bar(labels, percentages)
        plt.ylabel(f'Percentage of total {field} (%)')
        plt.title(f'Block-wise Percentage of Total {field}')
        fname = save_path or f'block_percentage_bar_{field}.png'
        plt.savefig(fname)
        plt.close()

    def plot_height_percentage_bar(self, field, axis='y', num_slices=100, save_path=None, data_type='cell'):
        import matplotlib.pyplot as plt
        """
        Plot bar chart of percentage of total summed value per height slice for the given field.
        """
        import matplotlib.pyplot as plt
        df = self.slice_and_average(axis=axis, num_slices=num_slices, data_type=data_type)
        if field not in df.columns:
            print(f"Field '{field}' not found in slice averages.")
            return
        values = df[field].fillna(0).values
        mids = df[f'{axis}_mid'].values
        total = np.sum(values)
        percentages = [100 * v / total if total > 0 else 0 for v in values]
        plt.figure()
        plt.bar(mids, percentages, width=(mids[1]-mids[0]) if len(mids)>1 else 1)
        plt.xlabel(f'{axis} (mid of slice)')
        plt.ylabel(f'Percentage of total {field} (%)')
        plt.title(f'Height-wise Percentage of Total {field}')
        fname = save_path or f'height_percentage_bar_{field}_{axis}.png'
        plt.savefig(fname)
        plt.close()

    def plot_slice_contour(self, field, axis='y', value=None, n_contours=10, save_path=None, data_type='cell'):
        """
        Plot contour on a 2D slice at a given axis=value.
        """
        if not RENDERING_AVAILABLE:
            print(f"Skipping slice contour plot for field '{field}' - rendering not available.")
            return
            
        try:
            plotter = pv.Plotter(off_screen=True)
            if value is None:
                value = (self.mesh.bounds[{ 'x':0, 'y':2, 'z':4 }[axis]] + self.mesh.bounds[{ 'x':1, 'y':3, 'z':5 }[axis]]) / 2
            slice = self.mesh.slice(normal=axis, origin={ 'x':(value,0,0), 'y':(0,value,0), 'z':(0,0,value) }[axis])
            data_dict = slice.cell_data if data_type == 'cell' else slice.point_data
            if field in data_dict:
                # Convert cell data to point data if needed for contouring
                if data_type == 'cell':
                    slice = slice.cell_data_to_point_data()
                contours = slice.contour(isosurfaces=n_contours, scalars=field)
                plotter.add_mesh(contours, scalars=field, cmap='viridis')
            else:
                plotter.add_mesh(slice)
            if save_path:
                plotter.show(screenshot=save_path)
                print(f"Slice contour plot saved: {save_path}")
            else:
                plotter.show()
            plotter.close()
        except Exception as e:
            print(f"Error creating slice contour plot: {e}")
            print("This is likely due to graphics/rendering limitations in your environment.")

    def plot_isosurface(self, field, value, save_path=None, data_type='cell'):
        """
        Plot iso-surface for a given field value.
        """
        plotter = pv.Plotter(off_screen=True)
        data_dict = self.mesh.cell_data if data_type == 'cell' else self.mesh.point_data
        if field in data_dict:
            mesh = self.mesh
            # Convert cell data to point data if needed for contouring
            if data_type == 'cell':
                mesh = mesh.cell_data_to_point_data()
            iso = mesh.contour(isosurfaces=[value], scalars=field)
            plotter.add_mesh(iso, scalars=field, cmap='viridis')
            if save_path:
                plotter.show(screenshot=save_path)
            else:
                plotter.show()
        else:
            print(f"Field '{field}' not found.")

    def plot_animated_contour(self, field, axis='y', num_slices=20, n_contours=10, data_type='cell'):
        """
        Animate contour plots across slices along an axis.
        """
        import matplotlib.pyplot as plt
        import matplotlib.animation as animation
        bounds = self.mesh.bounds
        axis_index = {'x': 0, 'y': 2, 'z': 4}[axis]
        min_val = bounds[axis_index]
        max_val = bounds[axis_index + 1]
        y_range = max_val - min_val
        slice_thickness = y_range / num_slices
        fig, ax = plt.subplots()
        ims = []
        for i in range(num_slices):
            value = min_val + i * slice_thickness
            slice = self.mesh.slice(normal=axis, origin={ 'x':(value,0,0), 'y':(0,value,0), 'z':(0,0,value) }[axis])
            data_dict = slice.cell_data if data_type == 'cell' else slice.point_data
            if field in data_dict:
                data = data_dict[field]
                im = ax.imshow(data.reshape(-1,1), aspect='auto', cmap='viridis', animated=True)
                ims.append([im])
        ani = animation.ArtistAnimation(fig, ims, interval=200, blit=True)
        plt.show()

    def plot_multi_field_contour(self, fields, n_contours=10, save_path=None, data_type='cell'):
        """
        Overlay contours for multiple fields.
        """
        plotter = pv.Plotter(off_screen=True)
        data_dict = self.mesh.cell_data if data_type == 'cell' else self.mesh.point_data
        mesh = self.mesh
        # Convert cell data to point data if needed for contouring
        if data_type == 'cell':
            mesh = mesh.cell_data_to_point_data()
        for field in fields:
            if field in data_dict:
                contours = mesh.contour(isosurfaces=n_contours, scalars=field)
                plotter.add_mesh(contours, scalars=field, cmap='viridis')
        if save_path:
            plotter.show(screenshot=save_path)
        else:
            plotter.show()

    def plot_profile_along_line(self, field, pointa, pointb, n_points=100, save_path=None, data_type='cell'):
        """
        Extract and plot field profile along a line from pointa to pointb.
        """
        import matplotlib.pyplot as plt
        line = pv.Line(pointa, pointb, resolution=n_points)
        sampled = self.mesh.sample_over_line(pointa, pointb, n_points)
        data_dict = sampled.cell_data if data_type == 'cell' else sampled.point_data
        if field in data_dict:
            plt.plot(np.linspace(0, 1, n_points), data_dict[field])
            plt.xlabel('Normalized Distance')
            plt.ylabel(field)
            plt.title(f'{field} Profile Along Line')
            fname = save_path or f'profile_line_{field}.png'
            plt.savefig(fname)
            plt.close()

    def plot_scatter(self, field_x, field_y, save_path=None, data_type='cell'):
        """
        Scatter plot of field_y vs field_x.
        """
        import matplotlib.pyplot as plt
        data_dict = self.mesh.cell_data if data_type == 'cell' else self.mesh.point_data
        if field_x in data_dict and field_y in data_dict:
            plt.scatter(data_dict[field_x], data_dict[field_y])
            plt.xlabel(field_x)
            plt.ylabel(field_y)
            plt.title(f'{field_y} vs {field_x}')
            fname = save_path or f'scatter_{field_y}_vs_{field_x}.png'
            plt.savefig(fname)
            plt.close()

    def plot_error_band(self, field, x_axis, error_field, save_path=None, data_type='cell'):
        """
        Line plot with error/uncertainty band.
        """
        import matplotlib.pyplot as plt
        data_dict = self.mesh.cell_data if data_type == 'cell' else self.mesh.point_data
        if field in data_dict and x_axis in data_dict and error_field in data_dict:
            y = data_dict[field]
            x = data_dict[x_axis]
            err = data_dict[error_field]
            plt.plot(x, y, label=field)
            plt.fill_between(x, y-err, y+err, alpha=0.3, label='Error Band')
            plt.xlabel(x_axis)
            plt.ylabel(field)
            plt.title(f'{field} with Error Band')
            plt.legend()
            fname = save_path or f'error_band_{field}_vs_{x_axis}.png'
            plt.savefig(fname)
            plt.close()

    def plot_time_series(self, field, time_values, save_path=None, data_type='cell'):
        """
        Plot time series for a field (if time-dependent data available).
        time_values: array-like of time points
        """
        import matplotlib.pyplot as plt
        # This assumes self.mesh.point_data[field] is 2D: (time, value)
        data_dict = self.mesh.cell_data if data_type == 'cell' else self.mesh.point_data
        data = data_dict[field]
        if data.ndim == 2 and len(time_values) == data.shape[0]:
            for i in range(data.shape[1]):
                plt.plot(time_values, data[:,i], label=f'Point {i}')
            plt.xlabel('Time')
            plt.ylabel(field)
            plt.title(f'Time Series of {field}')
            plt.legend()
            fname = save_path or f'timeseries_{field}.png'
            plt.savefig(fname)
            plt.close()

    def plot_vector_field(self, field_u, field_v, field_w=None, scale=1.0, data_type='point'):
        """
        Quiver/arrow plot for vector field (2D or 3D).
        """
        import matplotlib.pyplot as plt
        data_dict = self.mesh.cell_data if data_type == 'cell' else self.mesh.point_data
        u = data_dict[field_u]
        v = data_dict[field_v]
        if field_w:
            w = data_dict[field_w]
            # 3D quiver plot (matplotlib is limited, so use pyvista)
            arrows = pv.Arrow(start=(0,0,0), direction=(u.mean(), v.mean(), w.mean()), scale=scale)
            plotter = pv.Plotter(off_screen=True)
            plotter.add_mesh(arrows)
            plotter.show()
        else:
            x = self.mesh.points[:,0]
            y = self.mesh.points[:,1]
            plt.quiver(x, y, u, v, scale=scale)
            plt.xlabel('X')
            plt.ylabel('Y')
            plt.title('Vector Field')
            plt.show()

    def plot_streamlines(self, field_u, field_v, field_w=None, n_points=100, data_type='point'):
        """
        Streamline plot for vector field.
        """
        plotter = pv.Plotter(off_screen=True)
        data_dict = self.mesh.cell_data if data_type == 'cell' else self.mesh.point_data
        if field_w:
            vectors = np.column_stack((data_dict[field_u], data_dict[field_v], data_dict[field_w]))
        else:
            vectors = np.column_stack((data_dict[field_u], data_dict[field_v], np.zeros_like(data_dict[field_u])))
        self.mesh['vectors'] = vectors
        streamlines = self.mesh.streamlines(vectors='vectors', n_points=n_points)
        plotter.add_mesh(streamlines)
        plotter.show()

    def plot_surface(self, field, axis1='x', axis2='y', grid_size=100, save_path=None, data_type='point'):
        """
        3D surface plot of field values over a plane.
        """
        import matplotlib.pyplot as plt
        x = self.mesh.points[:, {'x':0, 'y':1, 'z':2}[axis1]]
        y = self.mesh.points[:, {'x':0, 'y':1, 'z':2}[axis2]]
        data_dict = self.mesh.cell_data if data_type == 'cell' else self.mesh.point_data
        z = data_dict[field]
        from mpl_toolkits.mplot3d import Axes3D
        fig = plt.figure()
        ax = fig.add_subplot(111, projection='3d')
        ax.plot_trisurf(x, y, z, cmap='viridis')
        ax.set_xlabel(axis1)
        ax.set_ylabel(axis2)
        ax.set_zlabel(field)
        plt.title(f'Surface Plot of {field}')
        fname = save_path or f'surface_{field}_{axis1}_{axis2}.png'
        plt.savefig(fname)
        plt.close()

    def plot_histogram(self, field, bins=30, save_path=None, data_type='cell'):
        """
        Histogram of field values.
        """
        import matplotlib.pyplot as plt
        data_dict = self.mesh.cell_data if data_type == 'cell' else self.mesh.point_data
        data = data_dict[field]
        plt.hist(data, bins=bins, color='skyblue', edgecolor='black')
        plt.xlabel(field)
        plt.ylabel('Count')
        plt.title(f'Histogram of {field}')
        fname = save_path or f'histogram_{field}.png'
        plt.savefig(fname)
        plt.close()

    def plot_heatmap(self, field, axis1='x', axis2='y', grid_size=100, save_path=None, data_type='cell'):
        """
        2D heatmap of field values on a plane.
        """
        import matplotlib.pyplot as plt
        x = self.mesh.points[:, {'x':0, 'y':1, 'z':2}[axis1]]
        y = self.mesh.points[:, {'x':0, 'y':1, 'z':2}[axis2]]
        data_dict = self.mesh.cell_data if data_type == 'cell' else self.mesh.point_data
        z = data_dict[field]
        heatmap, xedges, yedges = np.histogram2d(x, y, bins=grid_size, weights=z)
        plt.imshow(heatmap.T, origin='lower', aspect='auto', cmap='viridis')
        plt.xlabel(axis1)
        plt.ylabel(axis2)
        plt.title(f'Heatmap of {field}')
        fname = save_path or f'heatmap_{field}_{axis1}_{axis2}.png'
        plt.savefig(fname)
        plt.close()
        
    def get_block_names(self, verbose=True):
        """
        Returns a list of block names and indices if the dataset is a MultiBlock.
        Prints them if verbose=True.
        """
        if isinstance(self.dataset, pv.MultiBlock):
            block_names = []
            for i in range(len(self.dataset)):
                name = self.dataset.get_block_name(i)
                block_names.append((i, name))
                if verbose:
                    print(f"Block {i}: {name}")
            return block_names
        else:
            if verbose:
                print("Dataset is not a MultiBlock.")
            return []

    def get_variable_names(self, block_index=None, verbose=True):
        """
        Returns a list of variable names (point and cell data).
        If block_index is provided, gets variables for that block.
        Otherwise, gets variables for the main mesh.
        Prints them if verbose=True.
        """
        mesh = self.mesh
        if block_index is not None and isinstance(self.dataset, pv.MultiBlock):
            mesh = self.dataset[block_index]
        point_vars = list(mesh.point_data.keys())
        cell_vars = list(mesh.cell_data.keys())
        if verbose:
            print("Point Data Variables:", point_vars)
            print("Cell Data Variables:", cell_vars)
        return {"point_data": point_vars, "cell_data": cell_vars}

    def plot_contour_alternative(self, block_id=0, field='p', n_contours=10, data_type='cell', backend='auto'):
        """
        Alternative contour plotting with multiple backend options.
        
        Args:
            block_id: Index of the block to plot (for MultiBlock datasets)
            field: Name of the variable to contour
            n_contours: Number of contour levels
            data_type: Type of data to use ('cell' or 'point')
            backend: Backend to use ('auto', 'matplotlib', 'plotly', 'ascii')
        
        Returns:
            Filename of the saved plot or None if failed
        """
        print(f"Creating contour plot with backend: {backend}")
        
        if backend == 'auto':
            # Try backends in order of preference
            for try_backend in ['matplotlib', 'plotly', 'ascii']:
                try:
                    result = self._plot_contour_backend(block_id, field, n_contours, data_type, try_backend)
                    if result is not None:
                        return result
                except Exception as e:
                    print(f"Backend {try_backend} failed: {e}")
                    continue
            print("No working backend found for contour plotting")
            return None
        else:
            return self._plot_contour_backend(block_id, field, n_contours, data_type, backend)
    
    def _plot_contour_backend(self, block_id, field, n_contours, data_type, backend):
        """Internal method to handle specific backend"""
        if backend == 'matplotlib':
            return self._contour_matplotlib(block_id, field, n_contours, data_type)
        elif backend == 'plotly':
            return self._contour_plotly(block_id, field, n_contours, data_type)
        elif backend == 'ascii':
            return self._contour_ascii(block_id, field, n_contours, data_type)
        else:
            raise Exception(f"Unknown backend: {backend}")
    
    def _contour_matplotlib(self, block_id, field, n_contours, data_type):
        """Create 2D contour plot using matplotlib"""
        import matplotlib.pyplot as plt
        import numpy as np
        from scipy.interpolate import griddata
        
        # Get the appropriate block/mesh
        if isinstance(self.dataset, pv.MultiBlock):
            block = self.dataset[block_id]
        else:
            block = self.mesh
        
        # Get coordinates and data
        if data_type == 'cell':
            centers = block.cell_centers()
            coords = centers.points
            if field not in block.cell_data:
                raise Exception(f"Field '{field}' not found in cell data")
            data_values = block.cell_data[field]
        else:
            coords = block.points
            if field not in block.point_data:
                raise Exception(f"Field '{field}' not found in point data")
            data_values = block.point_data[field]
        
        # Project to 2D (use X-Y plane)
        x = coords[:, 0]
        y = coords[:, 1]
        z = data_values
        
        # Create regular grid for interpolation
        xi = np.linspace(x.min(), x.max(), 100)
        yi = np.linspace(y.min(), y.max(), 100)
        Xi, Yi = np.meshgrid(xi, yi)
        
        # Interpolate data to regular grid
        Zi = griddata((x, y), z, (Xi, Yi), method='linear')
        
        # Create contour plot
        fig, ax = plt.subplots(figsize=(12, 8))
        
        # Filled contours
        contourf = ax.contourf(Xi, Yi, Zi, levels=n_contours, cmap='viridis', alpha=0.8)
        
        # Contour lines
        contour = ax.contour(Xi, Yi, Zi, levels=n_contours, colors='black', alpha=0.4, linewidths=0.5)
        
        # Add colorbar
        cbar = plt.colorbar(contourf, ax=ax)
        cbar.set_label(field)
        
        # Labels and title
        ax.set_xlabel('X')
        ax.set_ylabel('Y')
        ax.set_title(f'Contour Plot: {field} (Block {block_id})')
        ax.set_aspect('equal')
        
        # Save the plot
        output_file = f'contour_{field}_block_{block_id}_matplotlib.png'
        plt.savefig(output_file, dpi=300, bbox_inches='tight')
        plt.close()
        
        print(f"Matplotlib contour plot saved: {output_file}")
        return output_file
    
    def _contour_plotly(self, block_id, field, n_contours, data_type):
        """Create interactive 3D scatter plot using plotly"""
        try:
            import plotly.graph_objects as go
            import plotly.offline as pyo
        except ImportError:
            raise Exception("Plotly not available")
        
        # Get the appropriate block/mesh
        if isinstance(self.dataset, pv.MultiBlock):
            block = self.dataset[block_id]
        else:
            block = self.mesh
        
        # Get coordinates and data
        if data_type == 'cell':
            centers = block.cell_centers()
            coords = centers.points
            if field not in block.cell_data:
                raise Exception(f"Field '{field}' not found in cell data")
            data_values = block.cell_data[field]
        else:
            coords = block.points
            if field not in block.point_data:
                raise Exception(f"Field '{field}' not found in point data")
            data_values = block.point_data[field]
        
        # Sample data for performance (if too many points)
        if len(coords) > 10000:
            import numpy as np
            indices = np.random.choice(len(coords), 10000, replace=False)
            coords = coords[indices]
            data_values = data_values[indices]
        
        # Create 3D scatter plot
        fig = go.Figure(data=go.Scatter3d(
            x=coords[:, 0],
            y=coords[:, 1],
            z=coords[:, 2],
            mode='markers',
            marker=dict(
                size=3,
                color=data_values,
                colorscale='Viridis',
                showscale=True,
                colorbar=dict(title=field)
            ),
            text=[f'{field}: {val:.3f}' for val in data_values],
            hovertemplate='<b>%{text}</b><br>X: %{x:.3f}<br>Y: %{y:.3f}<br>Z: %{z:.3f}<extra></extra>'
        ))
        
        fig.update_layout(
            title=f'3D Visualization: {field} (Block {block_id})',
            scene=dict(
                xaxis_title='X',
                yaxis_title='Y',
                zaxis_title='Z'
            ),
            width=1000,
            height=800
        )
        
        # Save as HTML
        output_file = f'contour_{field}_block_{block_id}_plotly.html'
        pyo.plot(fig, filename=output_file, auto_open=False)
        
        print(f"Plotly interactive plot saved: {output_file}")
        return output_file
    
    def _contour_ascii(self, block_id, field, n_contours, data_type):
        """Create ASCII art contour representation"""
        import numpy as np
        
        # Get the appropriate block/mesh
        if isinstance(self.dataset, pv.MultiBlock):
            block = self.dataset[block_id]
        else:
            block = self.mesh
        
        # Get coordinates and data
        if data_type == 'cell':
            centers = block.cell_centers()
            coords = centers.points
            if field not in block.cell_data:
                raise Exception(f"Field '{field}' not found in cell data")
            data_values = block.cell_data[field]
        else:
            coords = block.points
            if field not in block.point_data:
                raise Exception(f"Field '{field}' not found in point data")
            data_values = block.point_data[field]
        
        # Project to 2D
        x = coords[:, 0]
        y = coords[:, 1]
        
        # Create ASCII grid
        width, height = 80, 40
        x_grid = np.linspace(x.min(), x.max(), width)
        y_grid = np.linspace(y.min(), y.max(), height)
        
        # Create contour levels
        levels = np.linspace(data_values.min(), data_values.max(), n_contours)
        chars = ' .:;+=xX$&'
        
        output_file = f'contour_{field}_block_{block_id}_ascii.txt'
        
        with open(output_file, 'w') as f:
            f.write(f"ASCII Contour Plot: {field} (Block {block_id})\n")
            f.write("=" * 60 + "\n")
            f.write(f"Range: {data_values.min():.3f} to {data_values.max():.3f}\n")
            f.write("Legend: " + " ".join([f"{chars[i]}={levels[i]:.2f}" for i in range(0, len(chars), 2)]) + "\n")
            f.write("-" * 60 + "\n")
            
            for j in range(height):
                line = ""
                y_val = y_grid[height-1-j]  # Flip Y for proper orientation
                for i in range(width):
                    x_val = x_grid[i]
                    
                    # Find closest data point
                    distances = np.sqrt((x - x_val)**2 + (y - y_val)**2)
                    closest_idx = np.argmin(distances)
                    closest_value = data_values[closest_idx]
                    
                    # Map to character
                    level_idx = np.digitize(closest_value, levels) - 1
                    level_idx = max(0, min(len(chars)-1, level_idx))
                    line += chars[level_idx]
                
                f.write(line + "\n")
        
        print(f"ASCII contour plot saved: {output_file}")
        return output_file

